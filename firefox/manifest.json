{
  "manifest_version": 3,
  "name": "Zabbix Notifier",
  "version": "1.0.5",
  "description": "Notificações de problemas do Zabbix 7.0 com URL e token configuráveis.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zabbix-notifier@app-plugin-zabbix.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
