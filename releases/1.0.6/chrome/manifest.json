{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.6",
  "description": "__MSG_extDescription__",
  "default_locale": "pt_BR",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js"
  }
}
